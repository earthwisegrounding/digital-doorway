{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8767",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs"
      ],
      "port": 8767
    },
    {
      "name": "crm-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--config",
        "api/wrangler.toml",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787
    }
  ]
}
